# Variable names and placeholders only. Copy to .env.local and fill in locally.
# Real values are never committed: .env and .env.* are gitignored.

# Local development database (server-side only; never prefix with NEXT_PUBLIC_).
DATABASE_URL=postgresql://babysunray_dev:CHANGE_ME@localhost:5432/babysunray_dev

# Isolated integration-test database. The test tools refuse anything other than the local
# babysunray_test database and role (docs/testing.md, section 2).
TEST_DATABASE_URL=postgresql://babysunray_test:CHANGE_ME@localhost:5432/babysunray_test

# Authentication (Better Auth, docs/adr/0003-authentication-foundation.md). Server-side only.
# Secret: at least 32 random characters, unique per installation. Generate one with
#   openssl rand -base64 32
# The application refuses to start with this placeholder.
BETTER_AUTH_SECRET=CHANGE_ME
# The site's origin. Plain http is accepted only for localhost outside production.
BETTER_AUTH_URL=http://localhost:3000

# Optional /api/v1 request limits per signed-in user and minute (technical limits, not business policy).
# Empty means the defaults: 300 reads and 60 writes.
API_RATE_LIMIT_READS_PER_MINUTE=
API_RATE_LIMIT_WRITES_PER_MINUTE=

# Optional: the empty database `npm run backup:restore` restores into (docs/operations/runbook.md, section 8).
# Never the development or test database; the command refuses anything else.
RESTORE_DATABASE_URL=

# Optional: the folder that holds product photos (docs/operations/runbook.md, Product photos). An absolute path to an
# existing folder OUTSIDE this project, never inside it or under public/. Without it, photos cannot be uploaded.
# Photos are not in the database backups: copy this folder separately and check with `npm run media:verify`.
MEDIA_STORAGE_DIR=
# Production only: local photo storage is refused unless this is "allow" (only on a host whose disk is persistent
# and backed up; a deployment decision). Leave empty for local development.
MEDIA_LOCAL_STORAGE_IN_PRODUCTION=

# Optional: this installation's public identity in the storefront preview (src/config/installation.ts). Without them
# the preview shows a neutral name and no description or contact. Order rules, delivery zones and COD are not
# settings: they are decided per installation in code and policy.
STORE_NAME=
STORE_LINE_EN=
STORE_LINE_BN=
STORE_CONTACT_PHONE=
STORE_CONTACT_EMAIL=
# Optional preview colours (#rrggbb); refused unless text stays readable (contrast is checked).
STORE_THEME_INK=
STORE_THEME_ACCENT=
STORE_THEME_PAPER=

# Hosted installation (docs/operations/infrastructure.md). All optional; unset means the local behaviour above.
# DATABASE_RUNTIME=server | serverless, DATABASE_POOLER=direct | transaction (Supabase's port 6543 is a transaction
# pooler), DATABASE_POOL_MAX=5..20, DATABASE_SSL=require | verify-full (required when the database is not on this machine).
# A DATABASE_URL query string is refused; use these settings instead.
DATABASE_RUNTIME=
DATABASE_POOLER=
DATABASE_POOL_MAX=
DATABASE_SSL=
# PEM text of the provider's CA certificate, for DATABASE_SSL=verify-full.
DATABASE_SSL_CA=
# Migrations and backups on a hosted database: a direct or session connection, never the transaction pooler.
DIRECT_DATABASE_URL=

# Product photos: local (the folder above, default) or supabase (a PRIVATE Supabase Storage bucket).
MEDIA_STORAGE_PROVIDER=
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
# Server-side only; bypasses the bucket's access rules. Never public, never committed.
SUPABASE_SERVICE_ROLE_KEY=

# Turns on POST /api/internal/maintenance (404 without it). 32+ random characters, different from BETTER_AUTH_SECRET.
MAINTENANCE_SECRET=
# Only for a host whose scheduler can issue GET but not POST (for example Vercel Cron, whose CRON_SECRET must then equal MAINTENANCE_SECRET): set to true to let GET use the same Bearer secret.
MAINTENANCE_ALLOW_GET=

# Staging only (docs/operations/staging-setup.md): these go in .env.staging.local (git-ignored), never here or in .env.local.
# STAGING_MIGRATION_DATABASE_URL, STAGING_DATABASE_URL, STAGING_DATABASE_SSL, STAGING_DATABASE_SSL_ROOT_CERT,
# STAGING_SUPABASE_URL, STAGING_SUPABASE_PUBLISHABLE_KEY, STAGING_SUPABASE_SECRET_KEY, STAGING_STORAGE_BUCKET

# Cloudinary CDN for PUBLISHED product photos only (ADR-0010). All three together turn it on; none set means no CDN. Server-side only, never NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional, default babysunray/products (lowercase letters, digits, - and _, / between levels).
CLOUDINARY_FOLDER=

# Optional customer sign-in with Google (ADR-0011). Both or neither; without them "Continue with Google" is not offered and guest
# checkout works as before. Server-side only. The OAuth client's authorised redirect URI must be <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Trusted client address for per-client limits (checkout, sign-in): "netlify" on Netlify (its edge sets x-nf-client-connection-ip),
# empty everywhere else (no address header is trusted).
TRUSTED_PROXY=

# First-time Admin setup (ADR-0012): the setup code typed once at /admin/setup to create the first Owner. 32+ random characters,
# set out of band on the host. Setup closes for good once an Owner exists.
ADMIN_SETUP_TOKEN=

# Transactional email through Resend (ADR-0012): both or neither. Needed for customer email accounts, verification and password
# reset, and for verifying the first Owner's address. EMAIL_FROM is a sender on a domain verified in Resend, e.g. "Shop <hello@example.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Production installation only (docs/operations/installation-production.md): these go in .env.production.local (git-ignored).
# PRODUCTION_MIGRATION_DATABASE_URL, PRODUCTION_DATABASE_SSL, PRODUCTION_DATABASE_SSL_ROOT_CERT
