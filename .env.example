# Variable names and placeholders only. Copy to .env.local and fill in locally.
# Real values are never committed: .env and .env.* are gitignored.

# Local development database (server-side only; never prefix with NEXT_PUBLIC_).
DATABASE_URL=postgresql://babysunray_dev:CHANGE_ME@localhost:5432/babysunray_dev

# Isolated integration-test database. The test tools refuse anything other than the local
# babysunray_test database and role (README.md, Development).
TEST_DATABASE_URL=postgresql://babysunray_test:CHANGE_ME@localhost:5432/babysunray_test

# Authentication (Better Auth, docs/adr/0003-authentication-foundation.md). Server-side only.
# Secret: at least 32 random characters, unique per installation. Generate one with
#   openssl rand -base64 32
# The application refuses to start with this placeholder.
BETTER_AUTH_SECRET=CHANGE_ME
# The site's origin. Plain http is accepted only for localhost outside production.
BETTER_AUTH_URL=http://localhost:3000
