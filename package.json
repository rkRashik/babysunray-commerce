{
  "name": "babysunray-commerce",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.integration.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node scripts/migrate-dev.mts",
    "db:migrate:staging": "node scripts/migrate-staging.mts",
    "auth:bootstrap-owner": "node scripts/bootstrap-owner.mts",
    "auth:reset-owner-password": "node scripts/reset-owner-password.mts",
    "auth:bootstrap-owner:staging": "node scripts/bootstrap-owner-staging.mts",
    "config:check": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/register-src.mts scripts/config-check.mts",
    "media:backup": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/register-src.mts scripts/media-backup-create.mts",
    "media:backup:verify": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/register-src.mts scripts/media-backup-verify.mts",
    "media:restore": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/register-src.mts scripts/media-restore.mts",
    "media:verify": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/register-src.mts scripts/media-verify.mts",
    "media:verify:staging": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/register-src.mts scripts/media-staging.mts verify",
    "media:backup:staging": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/register-src.mts scripts/media-staging.mts backup",
    "recovery:check": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/register-src.mts scripts/recovery-check.mts",
    "orders:expire-verification": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/register-src.mts scripts/expire-verification.mts",
    "maintenance:run": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/register-src.mts scripts/maintenance.mts",
    "backup:create": "node scripts/backup-create.mts",
    "backup:verify": "node scripts/backup-verify.mts",
    "backup:status": "node scripts/backup-status.mts",
    "migrations:review": "node scripts/migration-review.mts",
    "backup:restore": "node scripts/backup-restore.mts",
    "backup:create:staging": "node scripts/backup-staging.mts",
    "backup:drill": "vitest run --config vitest.drill.config.mts tests/drill/restore-drill.drill.ts",
    "media:drill": "vitest run --config vitest.drill.config.mts tests/drill/media-drill.drill.ts",
    "perf:bench": "vitest run --config vitest.perf.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "test:install": "playwright test --config playwright.install.config.ts",
    "test:staging": "node scripts/staging-test.mts",
    "staging:preflight": "node scripts/staging-preflight.mts",
    "staging:setup": "node scripts/staging-setup.mts",
    "netlify:env": "node --experimental-transform-types --no-warnings=ExperimentalWarning --import ./scripts/register-src.mts scripts/netlify-env.mts",
    "test:contract": "vitest run tests/api && vitest run --config vitest.integration.config.mts tests/db/api.integration.test.ts tests/db/api-write.integration.test.ts tests/db/api-orders.integration.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/hind-siliguri": "5.3.0",
    "@fontsource/tiro-bangla": "5.3.0",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.75.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "read-excel-file": "9.3.14",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
