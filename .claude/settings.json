{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.development)",
      "Read(/**/.env.production)",
      "Read(/**/.env.test)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Read(/secrets/**)",
      "Read(/private/**)",
      "Read(/backups/**)",
      "Read(/exports/**)",
      "Read(/**/*.dump)",
      "Read(/**/*.backup)",
      "Edit(/**/.env)",
      "Edit(/**/.env.local)",
      "Edit(/**/.env.*.local)",
      "Edit(/**/.env.development)",
      "Edit(/**/.env.production)",
      "Edit(/**/.env.test)",
      "Edit(/secrets/**)",
      "Edit(/private/**)",
      "Edit(/backups/**)",
      "Edit(/exports/**)",
      "Bash(git push)",
      "Bash(git push *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "Bash(vercel *)",
      "Bash(netlify *)",
      "Bash(wrangler *)",
      "Bash(render *)",
      "PowerShell(vercel *)",
      "PowerShell(netlify *)",
      "PowerShell(wrangler *)",
      "PowerShell(render *)",
      "mcp__plugin_render_render__*"
    ],
    "ask": [
      "Bash(git init)",
      "Bash(git init *)",
      "Bash(git commit *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npx *)",
      "Bash(rm *)",
      "PowerShell(git init)",
      "PowerShell(git init *)",
      "PowerShell(git commit *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(npm install)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npx *)",
      "PowerShell(Remove-Item *)"
    ]
  }
}
